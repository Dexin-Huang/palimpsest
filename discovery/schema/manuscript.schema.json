{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palimpsest.discovery.manuscript.v1",
  "title": "Vatican Manuscript Discovery Record",
  "description": "Schema for tracking discovered and analyzed Vatican manuscripts",
  "type": "object",
  "required": ["manuscript_id", "shelfmark", "repository", "discovery", "status"],
  "properties": {
    "manuscript_id": {
      "type": "string",
      "description": "Unique identifier (e.g., vat_pal_lat_1267)"
    },
    "shelfmark": {
      "type": "string",
      "description": "Official library shelfmark (e.g., Pal.lat.1267)"
    },
    "repository": {
      "type": "string",
      "enum": ["BAV", "ASV", "other"],
      "description": "BAV=Biblioteca Apostolica Vaticana, ASV=Archivio Segreto Vaticano"
    },
    "collection": {
      "type": "string",
      "description": "Collection name (e.g., Palatini latini, Vaticani latini, Borghesiani)"
    },
    "iiif": {
      "type": "object",
      "properties": {
        "manifest_url": { "type": "string", "format": "uri" },
        "viewer_url": { "type": "string", "format": "uri" },
        "canvas_count": { "type": "integer" },
        "resolution_max": { "type": "string" }
      }
    },
    "physical": {
      "type": "object",
      "properties": {
        "folios": { "type": "integer" },
        "dimensions_cm": { "type": "string" },
        "material": { "type": "string", "enum": ["parchment", "paper", "mixed"] },
        "date_range": { "type": "string" },
        "script_type": { "type": "string" },
        "condition": { "type": "string" }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "subject_areas": { "type": "array", "items": { "type": "string" } },
        "works_contained": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "author": { "type": "string" },
              "folios": { "type": "string" },
              "incipit": { "type": "string" }
            }
          }
        },
        "catalog_description": { "type": "string" }
      }
    },
    "scholarship": {
      "type": "object",
      "properties": {
        "catalog_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "year": { "type": "integer" },
              "citation": { "type": "string" }
            }
          }
        },
        "editions": { "type": "array", "items": { "type": "string" } },
        "studies": { "type": "array", "items": { "type": "string" } },
        "transcriptions_exist": { "type": "boolean" },
        "last_scholarly_attention": { "type": "string" },
        "obscurity_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "1=well-studied, 10=completely unknown"
        }
      }
    },
    "our_work": {
      "type": "object",
      "properties": {
        "transcription_status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "complete", "reviewed"]
        },
        "pages_transcribed": { "type": "integer" },
        "quality_score": { "type": "string" },
        "project_path": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "folio": { "type": "string" },
              "significance": { "type": "string" }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["discovered_date", "discovered_by", "method"],
      "properties": {
        "discovered_date": { "type": "string", "format": "date" },
        "discovered_by": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["catalog_search", "iiif_crawl", "reference_chase", "serendipity", "ai_suggestion"]
        },
        "initial_interest": { "type": "string" },
        "wtf_factor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How surprising/unusual is this? 1=expected, 10=what the heck?!"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["discovered", "cataloged", "downloading", "transcribing", "analyzing", "complete", "abandoned"]
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "agent": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    }
  }
}
