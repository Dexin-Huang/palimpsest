# Direct factory model calls default to OpenAI Codex through OMP. Start one
# interactive OMP session and run `/login openai-codex` before using the line.
PALIMPSEST_MODEL_VISION=openai-codex/gpt-5.6-luna
PALIMPSEST_MODEL_READING=openai-codex/gpt-5.6-luna

# Optional: only required when either model override selects a Gemini model.
GEMINI_API_KEY=your-api-key-here

# Optional workspace overrides.
PALIMPSEST_LIBRARY_ROOT=library
PALIMPSEST_FACTORY_DB=library/factory.db
PALIMPSEST_CATALOG_DB=library/catalog.db
