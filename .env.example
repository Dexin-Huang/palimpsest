# Slash-qualified selectors execute through OMP. Authenticate OpenAI Codex
# with `/login openai-codex`; token-plan/* (Qwen3.8-Max) uses OMP's Token
# Plan provider login — no API key lives in this file.
# Reading uses its own primary and secondary lanes; editorial serves survey,
# translate, and reconstruct.
PALIMPSEST_MODEL_READING=token-plan/qwen3.8-max
PALIMPSEST_MODEL_READING_SECONDARY=openai-codex/gpt-5.6-sol
PALIMPSEST_MODEL_EDITORIAL=openai-codex/gpt-5.6-sol
PALIMPSEST_MODEL_ADJUDICATOR=openai-codex/gpt-5.6-sol
# Migration: rename PALIMPSEST_MODEL_VISION to PALIMPSEST_MODEL_READING.
# The legacy name is rejected rather than accepted as an alias.
# Gemini was retired 2026-08; google/* selectors fail loudly at the gateway.

# Throughput and deadline controls. Keep provider concurrency conservative:
# dual readers use separate providers concurrently, so 3 permits up to 6 model
# calls while preventing either provider from receiving more than 3 at once.
# The bound is enforced factory-wide by a cross-process file lease in
# <library>/.gateway-locks, so subprocess cells and agent sessions share the
# same per-provider cap as inline calls.
PALIMPSEST_MODEL_PROVIDER_WORKERS=3
PALIMPSEST_MODEL_TIMEOUT_SECONDS=7200
PALIMPSEST_AGENT_TIMEOUT_SECONDS=14400
PALIMPSEST_CELL_TIMEOUT_SECONDS=28800

# Optional workspace overrides.
PALIMPSEST_LIBRARY_ROOT=library
PALIMPSEST_FACTORY_DB=library/factory.db
PALIMPSEST_EVALUATION_DB=library/evaluations/evaluation.sqlite3

# Operator knobs read directly by their modules (not recipe interpolation):
# the OMP executable used by the gateway; retain exodia harness output dirs;
# the Python interpreter and object root for the RF-DETR align runtime.
PALIMPSEST_OMP_COMMAND=omp
PALIMPSEST_RETAIN_OUTPUTS=0
PALIMPSEST_RFDETR_PYTHON=
PALIMPSEST_RFDETR_OBJECT_ROOT=
