# Slash-qualified selectors execute through OMP. Authenticate OpenAI Codex
# with `/login openai-codex` and configure OMP's Google provider before a run.
# The primary setting serves read, survey, translate, and reconstruct.
PALIMPSEST_MODEL_READING=openai-codex/gpt-5.6-sol
PALIMPSEST_MODEL_READING_SECONDARY=google/gemini-3.6-flash
PALIMPSEST_MODEL_ADJUDICATOR=anthropic/claude-fable-5
# Migration: rename PALIMPSEST_MODEL_VISION to PALIMPSEST_MODEL_READING.
# The legacy name is rejected rather than accepted as an alias.
# OMP's Google provider and optional bare-gemini direct overrides accept:
# GEMINI_API_KEY=your-api-key-here

# Optional workspace overrides.
PALIMPSEST_LIBRARY_ROOT=library
PALIMPSEST_FACTORY_DB=library/factory.db
PALIMPSEST_CATALOG_DB=library/catalog.db
