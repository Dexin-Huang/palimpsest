# Required for Gemini-backed read, survey, translate, and reconstruct stations.
GEMINI_API_KEY=your-api-key-here

# Recipe model defaults.
PALIMPSEST_MODEL_VISION=gemini-3.6-flash
PALIMPSEST_MODEL_READING=gemini-3.5-flash-lite

# Optional workspace overrides.
PALIMPSEST_LIBRARY_ROOT=library
PALIMPSEST_FACTORY_DB=library/factory.db
