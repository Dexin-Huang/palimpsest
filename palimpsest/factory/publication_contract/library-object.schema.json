{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpsest.invalid/contracts/library-object.schema.json",
  "title": "LibraryObject",
  "description": "One immutable Palimpsest library release containing published Book objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "contract",
    "contract_version",
    "bundle_id",
    "schemas",
    "books",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "profile": { "const": "palimpsest-library" },
    "contract": { "const": "palimpsest-publication" },
    "contract_version": { "const": "2.0.0" },
    "bundle_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "book"],
      "properties": {
        "library": { "$ref": "#/$defs/schemaReference" },
        "book": { "$ref": "#/$defs/schemaReference" }
      }
    },
    "books": {
      "type": "array",
      "items": { "$ref": "#/$defs/publishedBook" }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/publishedFile" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "publishedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "publishedFolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "original", "enhanced", "alignment"],
      "properties": {
        "page_id": { "type": "string", "minLength": 1 },
        "original": { "$ref": "#/$defs/path" },
        "enhanced": {
          "oneOf": [
            { "$ref": "#/$defs/path" },
            { "type": "null" }
          ]
        },
        "alignment": {
          "oneOf": [
            { "$ref": "#/$defs/path" },
            { "type": "null" }
          ]
        }
      }
    },
    "publishedBook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "model", "epub", "folios"],
      "properties": {
        "doc_id": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/path" },
        "epub": { "$ref": "#/$defs/path" },
        "folios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publishedFolio" }
        }
      }
    }
  }
}
